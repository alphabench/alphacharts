{
  "name": "@alphacharts/extend",
  "version": "0.0.0",
  "private": true,
  "description": "Adapters for alphacharts: let a host add drawing tools, studies, analyses and a natural-language assistant to a chart.",
  "keywords": [
    "chart",
    "plugin",
    "adapter",
    "trading"
  ],
  "license": "MIT",
  "author": "Alphabench",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphabench/alphacharts.git",
    "directory": "packages/extend"
  },
  "homepage": "https://github.com/alphabench/alphacharts#readme",
  "bugs": {
    "url": "https://github.com/alphabench/alphacharts/issues"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:dist": "tsc -p tsconfig.dist.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@alphacharts/drawings": "workspace:*",
    "@alphacharts/indicators": "workspace:*"
  },
  "devDependencies": {
    "@alphacharts/core": "workspace:*",
    "@alphacharts/drawings": "workspace:*",
    "@alphacharts/indicators": "workspace:*",
    "@alphacharts/script": "workspace:*",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
