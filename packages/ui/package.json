{
  "name": "@alphacharts/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/element.ts",
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "development": "./src/element.ts",
      "types": "./dist/types/element.d.ts",
      "default": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:dist": "tsc -p tsconfig.dist.json",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "11.0.0"
  },
  "peerDependencies": {
    "@alphacharts/alerts": "workspace:*",
    "@alphacharts/chart-types": "workspace:*",
    "@alphacharts/core": "workspace:*",
    "@alphacharts/drawings": "workspace:*",
    "@alphacharts/i18n": "workspace:*",
    "@alphacharts/indicators": "workspace:*",
    "@alphacharts/orderflow": "workspace:*"
  },
  "devDependencies": {
    "@alphacharts/alerts": "workspace:*",
    "@alphacharts/chart-types": "workspace:*",
    "@alphacharts/core": "workspace:*",
    "@alphacharts/drawings": "workspace:*",
    "@alphacharts/i18n": "workspace:*",
    "@alphacharts/indicators": "workspace:*",
    "@alphacharts/orderflow": "workspace:*",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
