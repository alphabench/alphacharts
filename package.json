{
  "name": "alphacharts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "check:dist": "pnpm build && node scripts/check-deps.mjs && pnpm -r --filter \"./packages/*\" --if-present typecheck:dist",
    "test": "pnpm -r test",
    "dev": "pnpm -C apps/playground dev",
    "size": "node scripts/size.mjs",
    "bench": "pnpm -C bench bench",
    "bench:compare": "pnpm -C bench compare",
    "bench:compare-report": "node scripts/compare-report.mjs",
    "visual": "pnpm -C bench visual",
    "check:skills": "node scripts/check-skills.mjs",
    "gen:skills": "node scripts/gen-skill-reference.mjs",
    "gen:skills:check": "node scripts/gen-skill-reference.mjs --check",
    "test:skills": "vitest run scripts/check-skills.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
