{
  "name": "alphacharts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "check:dist": "pnpm build && node scripts/check-deps.mjs && pnpm -r --filter \"./packages/*\" --if-present typecheck:dist",
    "test": "pnpm -r test",
    "dev": "pnpm -C apps/playground dev",
    "size": "node scripts/size.mjs",
    "bench": "pnpm -C bench bench",
    "visual": "pnpm -C bench visual"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
