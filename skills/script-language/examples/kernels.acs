indicator("Kernel semantics")
n = input.int(5, "Length", minval=2, maxval=100)
[basis, upper, lower] = ta.bb(close, n, 2)
plot(basis, "bb basis")
plot(upper, "bb upper")
plot(lower, "bb lower")
plot(ta.sma(close, n), "sma")
plot(ta.ema(close, n), "ema")
plot(ta.rma(close, n), "rma")
plot(ta.wma(close, n), "wma")
plot(ta.stdev(close, n), "stdev")
plot(ta.variance(close, n), "variance")
plot(ta.stdev(close, n, true), "stdev sample")
plot(ta.variance(close, n, sample = true), "variance sample")
plot(ta.sum(close, n), "sum")
plot(math.sum(close, n), "math.sum")
plot(ta.highest(high, n), "highest")
plot(ta.lowest(low, n), "lowest")
plot(ta.highestbars(close, n), "highestbars")
plot(ta.lowestbars(close, n), "lowestbars")
plot(ta.change(close, 2), "change 2")
plot(ta.linreg(close, n), "linreg")
plot(ta.tr, "tr")
plot(ta.atr(n), "atr")
